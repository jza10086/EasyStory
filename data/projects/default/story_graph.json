        "dialogueList": [
          {
            "id": "beat-1-1",
            "speakerId": "narrator",
            "speakerState": "环境氛围 / 焦硫味弥漫",
            "text": "空气中弥漫着刺鼻的焦硫味。蓝色的以太微光在破损的石柱间明灭不定。主角握紧短剑，穿过碎石来到古老祭坛前。"
          },
          {
            "id": "beat-1-2",
            "speakerId": "narrator",
            "speakerState": "危机突降 / 低吼逼近",
            "text": "在祭坛边缘，一位银发少女倒在血泊中。突然，地底深处传来沉闷的低吼，三头【岩甲噬魂兽】从阴影中爬出，猩红的复眼死死盯住了少女！"
          },
          {
            "id": "beat-1-3",
            "speakerId": "char-alice",
            "speakerState": "微弱呢喃，手指无力地抓着石板",
            "text": "唔……快走……别管我……"
          },
          {
            "id": "beat-1-4",
            "speakerId": "narrator",
            "speakerState": "全知视角 / 决断时刻",
            "text": "魔物咆哮着跃起，危机迫在眉睫，主角必须立即做出决断！"
          }
        ],
